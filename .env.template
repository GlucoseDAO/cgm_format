# Copy to .env in the directory you run cgm-cli from (and the test suite reads it from the repo root).
# .env is git-ignored; never commit real values. Values already in the environment win over the file.

# Nightscout instance for `cgm-cli download-nightscout` and the test suite's Nightscout fixtures.
NIGHTSCOUT_URL=
# Readable access token (sent as a query parameter), and/or the instance's API_SECRET (sent hashed).
NIGHTSCOUT_TOKEN=
NIGHTSCOUT_API_SECRET=
